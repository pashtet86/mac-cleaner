{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--bind",
        "127.0.0.1",
        "--directory",
        "website"
      ],
      "port": 4173
    },
    {
      "name": "site-worker",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "telemetry",
        "run",
        "site:dev"
      ],
      "port": 8788
    },
    {
      "name": "stats-worker",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "telemetry",
        "run",
        "dev"
      ],
      "port": 8787
    }
  ]
}
