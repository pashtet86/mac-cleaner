<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Anonymous statistics endpoint, set at build time: make dmg TELEMETRY_ENDPOINT=https://… -->
	<!-- Empty (the default) disables telemetry entirely. -->
	<key>DSTelemetryEndpoint</key>
	<string>$(TELEMETRY_ENDPOINT)</string>
</dict>
</plist>
