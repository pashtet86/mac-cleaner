#!/usr/bin/env bash
# Runs lint and tests before pushing. Skip once with: SKIP_TESTS=1 git push
set -uo pipefail

if [ "${SKIP_TESTS:-0}" = "1" ]; then
    echo "SKIP_TESTS=1 — skipping checks"
    exit 0
fi

make --no-print-directory check || {
    printf '\033[31m✖ Lint or tests failed — push aborted\033[0m\n'
    exit 1
}
