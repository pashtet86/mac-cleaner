#!/usr/bin/env bash
# Enforces Conventional Commits: https://www.conventionalcommits.org/en/v1.0.0/
set -uo pipefail

message_file="$1"
header=$(head -n 1 "$message_file")

# Messages generated by git itself.
case "$header" in
    Merge\ * | Revert\ \"* | fixup!\ * | squash!\ * | amend!\ *) exit 0 ;;
esac

types='feat|fix|perf|refactor|docs|test|build|ci|chore|style|revert'
pattern="^($types)(\([a-z0-9][a-z0-9-]*\))?!?: [^ ].*[^.]$"

error() {
    printf '\033[31m✖ %s\033[0m\n\n' "$1"
    printf '  Got:      %s\n' "$header"
    printf '  Expected: <type>(<scope>): <description>\n'
    printf '  Types:    %s\n' "${types//|/, }"
    printf '  Example:  feat(files): find duplicates with SHA-256\n\n'
    printf '  See CONTRIBUTING.md#commit-messages\n'
    exit 1
}

grep -Eq "$pattern" <<< "$header" || error "Commit header is not a Conventional Commit"
[ ${#header} -le 72 ] || error "Commit header is longer than 72 characters (${#header})"

second_line=$(sed -n '2p' "$message_file")
[ -z "$second_line" ] || error "Leave a blank line between the header and the body"

exit 0
